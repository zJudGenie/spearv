+        `ifdef TAGMPK
+            logic [MTAG_LEN-1:74] future;
+            logic [73:64]         mpk;
+        `else
+            logic [MTAG_LEN-1:64] future;
+        `endif
+        // lower 64 bit:
+        permissions_t         pte_perms; // [/*g,*/ u, x, w, r]
