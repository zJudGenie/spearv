+
+    typedef enum logic [1:0] {
+        MTAG0 = 2'b00,
+        MTAG32,
+        MTAG64,
+        MTAG128
+    } tagmode_t;
+
+    typedef enum logic [1:0] {
+        PL_KILO    = 2'b00, // 4 KiB
+        PL_MEGA    = 2'b01, // 2 MiB
+        PL_GIGA    = 2'b10, // 1 GiB
+        PL_INVALID = 2'b11
+    } page_level_t;
+
+    typedef enum logic [1:0] {
+        EAM_NORMAL = 2'b00,
+        EAM_ENCLAVE,
+        EAM_SHARED,
+        EAM_FUTURE2
+    } eam_t;
+
