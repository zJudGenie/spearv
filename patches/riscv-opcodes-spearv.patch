diff --git a/opcodes-custom b/opcodes-custom
index 1df6f0f..7b6d731 100644
--- a/opcodes-custom
+++ b/opcodes-custom
@@ -25,3 +25,15 @@
 @custom3.rd         rd rs1 imm12 14..12=4 6..2=0x1E 1..0=3
 @custom3.rd.rs1     rd rs1 imm12 14..12=6 6..2=0x1E 1..0=3
 @custom3.rd.rs1.rs2 rd rs1 imm12 14..12=7 6..2=0x1E 1..0=3
+
+# ltag/stag is similar to ld/sd.
+
+mtrap                rd rs1 imm12 14..12=0 6..2=0x1E 1..0=3
+#stag                imm12hi rs1 rs2 imm12lo 14..12=1 6..2=0x1E 1..0=3
+
+#ppage               rd rs1 imm12 14..12=6 6..2=0x1E 1..0=3
+
+rdtlb               rd rs1 imm12 14..12=3 6..2=0x1E 1..0=3
+ritlb               rd rs1 imm12 14..12=4 6..2=0x1E 1..0=3
+
+fence_t             rd imm20 6..2=0x02 1..0=3
