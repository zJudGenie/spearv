+static void _reset_state(e_metapage* statuspage_pa)
+{
+    statuspage_pa->tcs.mpp                = -1; // <0 or 0x800;
+    statuspage_pa->state                  = STATE_READY;
+    statuspage_pa->tcs.csrs_enclave.eam   = EAM_ENCLAVE;
+}
