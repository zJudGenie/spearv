+inline static uint64_t SATPtoDepth(uint64_t satp){
+    uint64_t mode = (satp & SATP64_MODE) >> 60;
+    uint64_t depth = 0;
+    if (mode == SATP_MODE_SV39) {
+        depth = 2;
+    } else if (mode == SATP_MODE_SV48) {
